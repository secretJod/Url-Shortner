# Copy this file to .env in the repo root before running `docker compose up`.
# docker-compose.yml reads these values both directly (${VAR} substitution)
# and by passing this file to the api container via env_file.
#
# *** LOCAL DEVELOPMENT ONLY ***
# Every value below is a known, committed placeholder (they're in the public
# git history). They are fine for `docker compose up` on your own machine but
# MUST NEVER be used in production. The app itself will refuse to start with
# ENV=production if it detects any of these placeholder values (see
# backend/internal/config/config.go).
#
# Production deploys do NOT use this file: .github/workflows/deploy.yml
# generates .env at deploy time from GitHub Actions Secrets. See
# deploy/README.md for the list of required secrets and how to set them.

# --- Postgres (matches docker-compose.yml postgres service) ---
# Prod equivalent: GitHub secret DATABASE_URL
DATABASE_URL="postgresql://urlshortener:urlshortener_dev_pw@postgres:5432/urlshortener?schema=public"

# --- Redis ---
REDIS_ADDR="redis:6379"
# Prod equivalent: GitHub secret REDIS_PASSWORD
REDIS_PASSWORD="change-me-redis-password"
REDIS_DB=0

# --- App ---
PORT=8080
# Prod equivalent: GitHub secret BASE_URL (the real public URL of the deploy)
BASE_URL="http://localhost:8080"
# Prod equivalent: hardcoded to "production" in deploy.yml. Never set this to
# "production" locally with dev secrets — config.go will refuse to start.
ENV="development"

# --- CORS ---
# Prod equivalent: GitHub secret CORS_ALLOWED_ORIGINS
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:80"

# --- IP hashing (analytics) ---
# Prod equivalent: GitHub secret IP_HASH_SECRET
IP_HASH_SECRET="change-me-ip-hash-secret"

# --- Mail (MailHog in local/dev compose) ---
# Prod equivalents: GitHub secrets SMTP_HOST, SMTP_PORT, SMTP_USER,
# SMTP_PASSWORD, MAIL_FROM
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM="no-reply@linksnip.local"

# --- Grafana ---
# Prod equivalent: GitHub secret GF_SECURITY_ADMIN_PASSWORD
GF_SECURITY_ADMIN_PASSWORD="change-me-grafana-password"
