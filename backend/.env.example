# Postgres
DATABASE_URL="postgresql://urlshortener:urlshortener_dev_pw@localhost:5432/urlshortener?schema=public"

# Redis
REDIS_ADDR="localhost:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# App
PORT=8080
BASE_URL="http://localhost:8080"
ENV="development"

# CORS
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://localhost:8080"

# Analytics IP hashing
IP_HASH_SECRET="dev-insecure-secret"

# Mail (MailHog for local dev)
# Leave SMTP_USER/SMTP_PASSWORD empty for MailHog (plaintext, unauthenticated,
# no TLS). Set both to send via a real relay — this switches mail.go to
# STARTTLS + AUTH PLAIN, which real relays (Gmail app password, Brevo,
# SendGrid free tiers) require.
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="no-reply@linksnip.local"
